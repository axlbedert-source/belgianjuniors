---
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SponsorStrip from '../components/SponsorStrip.astro';
import EventSchedule from '../components/EventSchedule.astro';
import hero from '../assets/home-hero.jpg';
import { Content as Recap, frontmatter } from '../data/home.md';
import { getPosts } from '../lib/content';

const latest = (await getPosts()).slice(0, 3);
const soaringspot = 'https://www.soaringspot.com/en_gb/jwgc2026';
const results = [
  { label: 'Club class', note: 'Final total after task 11', url: `${soaringspot}/results/club/task-11-on-2026-08-14/total` },
  { label: 'Standard class', note: 'Final total after task 11', url: `${soaringspot}/results/standard/task-11-on-2026-08-14/total` },
];
---
<Base description="Follow the Belgian Junior Gliding Team at the JWGC 2026 in Aalen, Germany.">
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text" data-enter>
        <h1>{frontmatter.title}</h1>
        <div class="hero__recap"><Recap /></div>
        <div class="actions">
          <a class="btn" href="/blog">Read the daily blog <Icon name="arrow-right" class="arrow" /></a>
          <a class="btn btn--ghost" href="#results">See the final results</a>
        </div>
      </div>
      <div class="hero__photo">
        <Image src={hero} alt="Four members of the Belgian team in team shirts with Gear Up the dog, in front of a lake" widths={[480, 720, 960, 1280]} sizes="(min-width: 1000px) 46vw, 92vw" loading="eager" fetchpriority="high" />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="latest-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 id="latest-title">Latest news</h2>
        </div>
        <a class="btn btn--ghost" href="/blog">All posts <Icon name="arrow-right" class="arrow" /></a>
      </div>
      <div class="grid">
        {latest.map((post) => <PostCard post={post} headingLevel={3} />)}
      </div>
    </div>
  </section>

  <SponsorStrip />

  <section class="section" id="timeline" aria-labelledby="schedule-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 id="schedule-title">Event schedule</h2>
        </div>
      </div>
      <EventSchedule />
    </div>
  </section>

  <section class="section section--tint" id="results" aria-labelledby="results-title">
    <div class="wrap">
      <div class="section-head">
        <div>
          <h2 id="results-title">Final Results</h2>
        </div>
      </div>
      <ul class="results">
        {results.map((r) => (
          <li class="card card--link result">
            <p class="card__meta">{r.note}</p>
            <h3 class="card__title"><a href={r.url} target="_blank" rel="noopener">{r.label}<span class="visually-hidden"> results (opens in a new tab)</span></a></h3>
            <span class="result__go" aria-hidden="true">soaringspot.com <Icon name="external" size={16} /></span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--night" id="tracking" aria-labelledby="tracking-title">
    <div class="wrap tracking">
      <div>
        <h2 id="tracking-title">Live Tracking</h2>
        <p class="lede muted">The championships are over, so there is nothing live to follow right now. Every task, with all pilots and their flights, stays on SoaringSpot.</p>
      </div>
      <div class="actions">
        <a class="btn" href={soaringspot} target="_blank" rel="noopener">Open JWGC 2026 on SoaringSpot <Icon name="external" class="arrow" /></a>
        <a class="btn btn--ghost" href="https://glidertracker.org/" target="_blank" rel="noopener">GliderTracker live map <Icon name="external" class="arrow" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 3vw, 2rem); }
  .hero__grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .hero__recap { font-size: 1.08rem; }
  .hero__recap :global(p) { color: var(--muted); }
  .hero__recap :global(strong) { color: var(--ink); }
  .hero__recap :global(p:first-child) { font-size: 1.22rem; color: var(--ink); }
  .hero .actions { margin-top: 1.75rem; }
  .hero__photo { position: relative; }
  .hero__photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 60%; border-radius: calc(var(--radius) * 1.6); box-shadow: var(--shadow-up); }
  .hero__photo::after { content: ''; position: absolute; left: 1.5rem; right: 1.5rem; bottom: -10px; height: 10px; border-radius: 0 0 8px 8px; background: linear-gradient(90deg, var(--ink) 0 33.3%, var(--yellow) 33.3% 66.6%, var(--red) 66.6%); }
  @media (max-width: 1000px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__photo { order: -1; }
    .hero__photo img { aspect-ratio: 4 / 3; }
  }

  .results { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr)); gap: 1.5rem; margin: 0; padding: 0; list-style: none; }
  .result { padding: 1.75rem; gap: 0.5rem; }
  .result .card__title { font-family: var(--font-head); font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; }
  .result__go { display: inline-flex; align-items: center; gap: 0.35rem; margin-top: 1.5rem; color: var(--sky); font-weight: 600; }

  .tracking { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem 4rem; align-items: end; }
  .tracking .actions { justify-content: flex-end; }
  @media (max-width: 900px) { .tracking { grid-template-columns: 1fr; } .tracking .actions { justify-content: flex-start; } }
</style>
