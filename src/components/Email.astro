---
// Email link without a plain mailto: in the HTML. The address is stored reversed and
// base64-encoded, and a tiny script turns it into a working link in the browser.
interface Props { user: string; domain: string; label?: string; class?: string; showAddress?: boolean }
const { user, domain, label, class: cls, showAddress = false } = Astro.props;
const code = Buffer.from(`${user}@${domain}`.split('').reverse().join('')).toString('base64');
const readable = `${user} [at] ${domain.replace(/\./g, ' [dot] ')}`;
---
<a class:list={['js-email', cls]} data-e={code} data-show={showAddress ? '1' : undefined} href="#contact">{label ?? readable}</a>
<script>
  document.querySelectorAll<HTMLAnchorElement>('a.js-email').forEach((a) => {
    const address = atob(a.dataset.e ?? '').split('').reverse().join('');
    a.href = 'mailto:' + address;
    if (a.dataset.show) a.textContent = address;
  });
</script>
