---
// Scrolling sponsor logos. The second copy of the list is hidden from screen readers
// and keyboard, the loop pauses on hover/focus and with the button, and it stands
// still as a wrapped row for people who prefer reduced motion.
import { Image } from 'astro:assets';
import { getSponsors } from '../lib/content';
import { useTranslations, type Lang } from '../i18n/ui';
interface Props { lang?: Lang; heading?: boolean }
const { lang, heading = true } = Astro.props;
const t = useTranslations(lang);
const sponsors = await getSponsors();
---
<section class="strip" aria-labelledby="sponsor-strip-title">
  <div class="wrap strip__head">
    <h2 id="sponsor-strip-title" class={heading ? 'strip__title' : 'visually-hidden'}>{t('sponsors.strip')}</h2>
    <button class="strip__toggle" type="button" aria-pressed="false" data-pause={t('sponsors.pause')} data-play={t('sponsors.play')}>
      <span class="strip__icon" aria-hidden="true"></span><span class="strip__label">{t('sponsors.pause')}</span>
    </button>
  </div>
  <div class="wrap">
    <div class="strip__viewport">
      <div class="strip__track">
        {[0, 1].map((copy) => (
          <ul class="strip__list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {sponsors.map(({ data }) => (
              <li>
                <a href={data.url} target="_blank" rel="noopener" tabindex={copy === 1 ? -1 : undefined}>
                  <Image src={data.logo} alt={copy === 1 ? '' : data.name} height={80} densities={[1, 2]} loading="lazy" />
                  {copy === 0 && <span class="visually-hidden"> (opens in a new tab)</span>}
                </a>
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Pause the loop while it is off-screen so it does not burn GPU for nothing.
  const io = new IntersectionObserver((entries) => entries.forEach((e) => e.target.classList.toggle('is-offscreen', !e.isIntersecting)));
  document.querySelectorAll('.strip').forEach((s) => io.observe(s));
  document.querySelectorAll<HTMLButtonElement>('.strip__toggle').forEach((btn) => {
    const strip = btn.closest('.strip');
    btn.addEventListener('click', () => {
      const paused = btn.getAttribute('aria-pressed') !== 'true';
      btn.setAttribute('aria-pressed', String(paused));
      strip?.classList.toggle('is-paused', paused);
      btn.querySelector('.strip__label')!.textContent = paused ? btn.dataset.play! : btn.dataset.pause!;
    });
  });
</script>

<style>
  .strip { padding-block: clamp(2.5rem, 5vw, 3.5rem); border-block: 1px solid var(--line); background: var(--surface); }
  .strip__head { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .strip__title { margin: 0; font-size: 1.15rem; letter-spacing: -0.01em; }
  .strip__toggle {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 44px; padding: 0 0.9rem;
    border: 1px solid var(--line); border-radius: 999px; background: var(--bg); color: var(--ink);
    font: 600 0.9rem var(--font-sans); cursor: pointer; touch-action: manipulation; transition: border-color 0.2s ease, transform 0.15s var(--ease);
  }
  .strip__toggle:hover { border-color: var(--ink); }
  .strip__toggle:active { transform: scale(0.97); transition-duration: 0s; }
  .strip__icon { width: 10px; height: 12px; border-inline: 3px solid currentColor; }
  .strip__toggle[aria-pressed='true'] .strip__icon { border: 0; border-left: 10px solid currentColor; border-block: 6px solid transparent; width: 0; height: 0; }

  .strip__viewport { overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent); }
  .strip__track { display: flex; width: max-content; animation: strip-scroll 40s linear infinite; }
  .strip__viewport:hover .strip__track,
  .strip__viewport:focus-within .strip__track,
  .strip.is-paused .strip__track,
  .strip.is-offscreen .strip__track { animation-play-state: paused; }
  .strip__list { display: flex; align-items: center; gap: clamp(2rem, 5vw, 4rem); margin: 0; padding: 0 clamp(1rem, 2.5vw, 2rem); list-style: none; }
  .strip__list a { display: flex; align-items: center; justify-content: center; height: 88px; padding: 4px; border-radius: var(--radius-sm); }
  .strip__list img { height: auto; max-height: 72px; width: auto; max-width: 170px; object-fit: contain; filter: grayscale(1); opacity: 0.75; transition: filter 0.2s ease, opacity 0.2s ease, transform 0.15s var(--ease); }
  .strip__list a:hover img, .strip__list a:focus-visible img { filter: none; opacity: 1; }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) { .strip__list a:hover img { transform: scale(1.02); } }
  @keyframes strip-scroll { to { transform: translateX(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .strip__toggle { display: none; }
    .strip__viewport { mask-image: none; }
    .strip__track { animation: none; width: auto; }
    .strip__list { flex-wrap: wrap; justify-content: center; padding: 0; }
    .strip__list[aria-hidden='true'] { display: none; }
  }
</style>
