---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { useTranslations, type Lang } from '../i18n/ui';
interface Props { lang?: Lang }
const t = useTranslations(Astro.props.lang);
---
<a href="/" class="logo">
  <Image src={logo} alt="" width={52} height={52} densities={[1, 2]} loading="eager" />
  <span class="logo__text"><span>{t('site.line1')}</span><span>{t('site.line2')}</span></span>
  <span class="visually-hidden">– {t('nav.home')}</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; color: inherit; text-decoration: none; min-height: 48px; }
  .logo img { width: 52px; height: 52px; }
  .logo__text { display: flex; flex-direction: column; font-family: var(--font-head); font-weight: 800; line-height: 1.05; font-size: 1.05rem; letter-spacing: -0.01em; }
  .logo__text span:last-child { font-weight: 600; color: var(--muted); }
  .logo:hover { color: inherit; }
</style>
