---
import Base from '../layouts/Base.astro';
import PostCard from './PostCard.astro';
import type { Post } from '../lib/content';
import { useTranslations } from '../i18n/ui';
interface Props { posts: Post[]; current: number; last: number }
const { posts, current, last } = Astro.props;
const t = useTranslations();
const href = (n: number) => (n === 1 ? '/blog' : `/blog/page/${n}`);
---
<Base title={current === 1 ? t('blog.title') : `${t('blog.title')} – ${t('blog.page')} ${current}`} description={t('blog.intro')}>
  <section class="section blog">
    <div class="wrap">
      <header class="blog__head" data-enter>
        <p class="eyebrow">JWGC 2026</p>
        <h1>{t('blog.title')}</h1>
        <p class="lede">{t('blog.intro')}</p>
      </header>
      <div class="grid">
        {posts.map((post, i) => <PostCard post={post} eager={i < 3} />)}
      </div>
      {last > 1 && (
        <nav class="pager" aria-label="Blog pages">
          {current > 1 ? <a class="btn btn--ghost" href={href(current - 1)} rel="prev">← {t('blog.newer')}</a> : <span />}
          <ol>
            {Array.from({ length: last }, (_, i) => i + 1).map((n) => (
              <li><a href={href(n)} aria-current={n === current ? 'page' : undefined} aria-label={`${t('blog.page')} ${n}`}>{n}</a></li>
            ))}
          </ol>
          {current < last ? <a class="btn btn--ghost" href={href(current + 1)} rel="next">{t('blog.older')} →</a> : <span />}
        </nav>
      )}
    </div>
  </section>
</Base>
<style>
  .blog { padding-top: clamp(2.5rem, 6vw, 4.5rem); }
  .blog__head { margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1rem; margin-top: 3rem; }
  .pager > :last-child { justify-self: end; }
  .pager ol { display: flex; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .pager ol a { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--line); color: var(--ink); font-weight: 600; text-decoration: none; transition: border-color 0.18s, transform 0.18s var(--ease); }
  .pager ol a:hover { border-color: var(--ink); transform: translateY(-2px); }
  .pager ol a[aria-current='page'] { background: var(--ink); border-color: var(--ink); color: #fff; }
  @media (max-width: 640px) {
    .pager { grid-template-columns: 1fr; justify-items: center; }
    .pager > :last-child { justify-self: center; }
    .pager > span { display: none; }
  }
</style>
