---
import { getCollection } from 'astro:content';
import { formatDate } from '../i18n/ui';
const events = (await getCollection('events')).sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---
<ol class="schedule">
  {events.map(({ data }) => (
    <li class="schedule__item">
      <span class="schedule__dot" aria-hidden="true"></span>
      <div class="schedule__card">
        <p class="schedule__date">
          <time datetime={data.date.toISOString().slice(0, 10) + (data.time ? `T${data.time}` : '')}>
            {formatDate(data.date, 'en', { day: 'numeric', month: 'short' })}{data.time && ` — ${data.time}`}
          </time>
        </p>
        <h3 class="schedule__title">{data.title}</h3>
        <span class={`badge badge--${data.type.toLowerCase()}`}>{data.type}</span>
      </div>
    </li>
  ))}
</ol>
<style>
  .schedule { display: grid; grid-template-columns: repeat(8, 1fr); gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .schedule__item { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.9rem; }
  .schedule__item::before { content: ''; position: absolute; top: 7px; left: -0.375rem; right: -0.375rem; height: 3px; background: var(--line); }
  .schedule__item:first-child::before { left: 50%; }
  .schedule__item:last-child::before { right: 50%; }
  .schedule__dot { position: relative; width: 17px; height: 17px; border-radius: 50%; background: var(--surface); border: 4px solid var(--red); }
  .schedule__card { width: 100%; height: 100%; padding: 0.9rem 0.75rem; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); text-align: center; }
  .schedule__date { margin: 0 0 0.35rem; font-size: 0.85rem; font-weight: 600; color: var(--muted); text-transform: uppercase; letter-spacing: 0.04em; }
  .schedule__title { margin: 0 0 0.6rem; font-family: var(--font-sans); font-size: 1rem; font-weight: 600; letter-spacing: 0; line-height: 1.3; }
  .badge--training { background: #e2f0ea; color: #17694f; }
  .badge--official { background: #e4ebf3; color: #134c85; }
  .badge--ceremony { background: #fdf1c4; color: #6b4e00; }
  .badge--flying { background: #fde4e7; color: #a00c24; }
  .badge--social { background: #efe9e1; color: #6b3f1d; }

  @media (max-width: 1000px) {
    .schedule { grid-template-columns: 1fr; gap: 0; }
    .schedule__item { flex-direction: row; align-items: stretch; gap: 1rem; padding-bottom: 0.75rem; }
    .schedule__item::before { top: 0; bottom: 0; left: 7px; right: auto; width: 3px; height: auto; }
    .schedule__item:first-child::before { left: 7px; top: 1.4rem; }
    .schedule__item:last-child::before { right: auto; bottom: auto; height: 1.4rem; }
    .schedule__dot { flex: none; margin-top: 1.1rem; }
    .schedule__card { text-align: left; display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 0.2rem 1rem; }
    .schedule__date { grid-column: 1; }
    .schedule__title { grid-column: 1; margin: 0; }
    .schedule__card .badge { grid-column: 2; grid-row: 1 / span 2; }
  }
</style>
